{
	// Пользовательские комбинации горячих клавиш.
	// Переопределяют системные комбинации из config/default/hotkeys.json.
	// Можно переназначить любое действие или добавить свои клавиши в список "keys".

	// Показать / скрыть заголовок (только Alt+U и F9)
	"toggle_header": {
		"keys": ["Alt+U", "F9"],
		"description": "Показать / скрыть верхнюю панель управления (Header HUD)"
	},

	// 1. История изменений (Git Graph таймлайн)
	"toggle_history": {
		"keys": ["Ctrl+H", "Ctrl+Shift+G", "Alt+H"],
		"description": "Показать / скрыть историю изменений (Git Graph таймлайн)"
	},

	// 2. Информация и статистика (слов, символов, байт)
	"toggle_info": {
		"keys": ["Alt+I", "Ctrl+Shift+I"],
		"description": "Показать / скрыть информацию и статистику документа"
	},

	// 3. Поиск по документу (Search bar)
	"toggle_search": {
		"keys": ["Ctrl+F"],
		"description": "Показать / скрыть панель поиска (Search Bar)"
	},

	// 4. Переключение отображения имени / полного пути к файлу
	"toggle_path": {
		"keys": ["Alt+P"],
		"description": "Показать / скрыть путь к файлу (Path / Name)"
	},

	// 5. Переключение панели вкладок (Tab bar)
	"toggle_tabs": {
		"keys": ["Ctrl+T", "Alt+T"],
		"description": "Показать / скрыть панель вкладок (Tab Bar)"
	},



	// Сплит экрана
	"toggle_split": {
		"keys": ["Ctrl+\\"],
		"description": "Разделить экран (Split View)"
	},

	// Центрированный / полный лист
	"toggle_centered_mode": {
		"keys": ["Alt+J", "Ctrl+Shift+J"],
		"description": "Переключить ширину листа (по центру / на всю ширину)"
	},

	// Закрыть вкладку
	"close_tab": {
		"keys": ["Ctrl+W"],
		"description": "Закрыть текущую вкладку или сплит"
	},

	// Новый документ
	"new_tab": {
		"keys": ["Ctrl+N"],
		"description": "Создать новый документ"
	},

	// Новый документ в правой сплит-панели
	"new_tab_split": {
		"keys": ["Ctrl+Shift+N"],
		"description": "Создать новый документ в правой панели"
	},

	// Открыть файл
	"open_file": {
		"keys": ["Ctrl+O"],
		"description": "Открыть файл"
	},

	// Открыть файл в правой сплит-панели
	"open_file_split": {
		"keys": ["Ctrl+Shift+O"],
		"description": "Открыть файл в правой панели"
	},

	// Сохранить файл
	"save_file": {
		"keys": ["Ctrl+S"],
		"description": "Сохранить файл"
	},

	// Жирный шрифт
	"toggle_bold": {
		"keys": ["Ctrl+B"],
		"description": "Сделать выделенный текст жирным (**текст**)"
	},

	// Курсив
	"toggle_italic": {
		"keys": ["Ctrl+I"],
		"description": "Сделать выделенный текст курсивом (*текст*)"
	},

	// Открепить окно
	"detach_window": {
		"keys": ["Ctrl+D", "Alt+D", "Ctrl+В", "Ctrl+Д"],
		"description": "Открепить документ в отдельное окно"
	},

	// Открыть / закрыть глобальный граф связей
	"toggle_graph": {
		"keys": ["Ctrl+G"],
		"description": "Показать / скрыть глобальный граф связей всех заметок (Global Graph)"
	},

	// Открыть / закрыть локальный граф текущей заметки
	"toggle_local_graph": {
		"keys": ["Alt+G"],
		"description": "Показать / скрыть локальный граф связей текущей заметки (Local Graph)"
	},


	// Открыть структуру проекта (_Структура.md)
	"open_structure": {
		"keys": ["Ctrl+P", "Ctrl+Shift+P"],
		"description": "Открыть глобальную структуру проекта (_Структура.md)"
	},

	// Визуальное включение / отключение полосы прокрутки (Scrollbar)
	"toggle_scrollbar": {
		"keys": ["Alt+K"],
		"description": "Показать / скрыть полосу прокрутки (Scrollbar)"
	},

	// Визуальное включение / отключение полосы точек строк (Line Dots / Gutter)
	"toggle_line_dots": {
		"keys": ["Alt+L"],
		"description": "Показать / скрыть полосу точек и номеров строк (Line Dots / Gutter)"
	}
}

