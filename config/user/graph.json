{
	// Пользовательские настройки графа (переопределяют значения из config/default/graph.json).
	// Изменения применяются мгновенно на лету благодаря Hot Reload!
	"physics": {
		// Сила взаимного отталкивания узлов (чем больше, тем просторнее граф). По умолчанию: 3600
		"repulsion": 3600,

		// Максимальный радиус действия силы отталкивания в пикселях. По умолчанию: 800
		"repulsionDistanceMax": 800,

		// Желаемая длина ребра в состоянии покоя. По умолчанию: 85
		"linkDistance": 85,

		// Упругость ребер как резиновых пружин (0.01 - мягкая резина, 0.1 - тугая пружина). По умолчанию: 0.014
		"linkStrength": 0.001,

		// Степень пластичности: насколько сильно ребро запоминает растянутую форму (0.0 - чисто упругое). По умолчанию: 0.035
		"plasticDeformation": 0.01,

		// Предельная длина растяжения связи (в пикселях). По умолчанию: 300
		"plasticMaxDistance": 300,

		// Скорость медленного стягивания растянутого ребра обратно к норме. По умолчанию: 0.0005
		"plasticRecoveryRate": 0.0005,

		// Сила притяжения всех элементов графа к центру экрана. По умолчанию: 0.0005
		"gravity": 0.0005,

		// Коэффициент трения / затухания скорости (0.75 - быстро замирает, 0.90 - долго плавает). По умолчанию: 0.82
		"damping": 0.9,

		// Максимальная скорость смещения узла за один шаг физики (защита от скачков). По умолчанию: 15.0
		"maxVelocity": 15.0,

		// Разброс узлов при начальном построении. По умолчанию: 0.35
		"initialSpread": 0.35
	},
	"visual": {
		// Минимальный радиус узла (px). По умолчанию: 3.5
		"nodeRadiusMin": 3.5,

		// Максимальный радиус узла (px). По умолчанию: 8.5
		"nodeRadiusMax": 8.5,

		// Базовый радиус узла без связей (px). По умолчанию: 3.2
		"nodeRadiusBase": 3.2,

		// Добавочный радиус за каждую связь. По умолчанию: 1.3
		"nodeRadiusWeight": 1.3,

		// Цвет фона окна графа
		"backgroundColor": "#181818",

		// Цвет узлов-файлов Markdown
		"nodeColorFile": "#585858",

		// Цвет узлов-блоков трансклюзии
		"nodeColorBlock": "#424242",

		// Цвет узлов-тегов (#тег)
		"nodeColorTag": "#4c4c4c",

		// Яркость подсветки узла при наведении мыши
		"nodeHoverBrightness": 1.25,

		// Цвет линий связей
		"linkColor": "#363636",

		// Цвет линий связей при наведении на узел
		"linkHoverColor": "#666666",

		// Цвет текста названий заметок
		"labelColor": "#8a8a8a",

		// Цвет текста названий заметок при наведении курсора
		"labelHoverColor": "#ffffff",

		// Размер шрифта надписей узлов в пикселях
		"labelFontSize": 10
	}
}
