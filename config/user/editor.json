{
	// Пользовательские настройки редактора текста.
	// Переопределяют значения из config/default/editor.json.

	// Ширина текстового листа (px). По умолчанию: 800
	"sheet_width": 1000,

	// Шрифт текста
	"font_family": "Fira Code, Segoe UI, Inter, -apple-system, sans-serif",

	// Размер шрифта текста в пикселях. По умолчанию: 15
	"font_size": 15,

	// Высота строки (1.35 = 135%). По умолчанию: 1.35
	"line_height": 2,

	// Точки-маркеры на пустых строках и списках
	"show_line_dots": true,

	// Внутренние отступы листа в пикселях
	"padding_left": 0,
	"padding_right": 0,
	"padding_top": 6,
	"padding_bottom": 0,

	// Режим печатной машинки (удержание строки по центру)
	"typewriter_mode": false,

	// Режим концентрации
	"focus_mode": false,

	// Размер табуляции в пробелах
	"tab_size": 4
}
