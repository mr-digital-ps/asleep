{
  // Глобальные и контекстные горячие клавиши редактора.
  // Поддерживаемые модификаторы: Ctrl, Alt, Shift, Meta (Win/Cmd).
  // Поддерживаемые клавиши: буквы A-Z, цифры 0-9, F1-F12, Backspace, Tab, Space, Return/Enter, Escape и спецсимволы.
  // В массив "keys" можно указывать несколько альтернативных комбинаций.
  //
  // Системные жесты мыши (окно и холст):
  // - Alt + ЛКМ (drag): нативное перемещение окна приложения по рабочему столу ОС (Aero Snap / startSystemMove)
  // - ПКМ (drag): плавное перемещение окна приложения по экрану ОС
  // - Space + ЛКМ (drag) или СКМ (drag): панорамирование камеры бесконечного холста (режим «Рука»)

  // Полное скрытие/показ шапки (Header)
  "toggle_header": {
    "keys": ["Alt+U", "F9"],
    "description": "Показать / скрыть верхнюю панель управления (Header HUD)"
  },

  // 1. История изменений (Git Graph таймлайн) — строго Alt+H или Ctrl+H
  "toggle_history": {
    "keys": ["Alt+H"],
    "description": "Показать / скрыть историю изменений (Git Graph таймлайн)"
  },

  // 1.1 Переключение режима истории (Снимок ⟷ Дифф изменений) — Alt+D
  "toggle_history_diff": {
    "keys": ["Alt+D"],
    "description": "Переключить отображение истории: чистый снимок ⟷ дифф изменений"
  },

  // 2. Информация и статистика (слов, символов, байт) — строго Alt+I
  "toggle_info": {
    "keys": ["Alt+I"],
    "description": "Показать / скрыть информацию и статистику документа"
  },

  // 3. Переключение отображения имени / полного пути (Папка.Файл.Блок) — Alt+P
  "toggle_path": {
    "keys": ["Alt+P"],
    "description": "Переключить отображение: имя файла / полный путь (Папка.Файл.Блок)"
  },

  // 4. Ползунок сюжетного таймлайна (станции и эпохи) — Alt+T
  "toggle_timeline": {
    "keys": ["Alt+T"],
    "description": "Показать / скрыть ползунок сюжетного таймлайна (Timeline Scrub Bar)"
  },

  // Полноэкранный режим окна приложения (Full Screen / Maximize)

  "toggle_fullscreen": {
    "keys": ["F11", "Alt+Return"],
    "description": "Переключить полноэкранный режим окна"
  },

  // Быстрое переключение листа: фиксированная центрированная ширина <-> растянуть на все окно
  "toggle_centered_mode": {
    "keys": ["Alt+W"],
    "description": "Переключить ширину листа (по центру / на всю ширину)"
  },

  // Центрировать камеру холста к активной панели
  "center_canvas": {
    "keys": ["Alt+0", "Ctrl+0"],
    "description": "Центрировать камеру холста к активной панели"
  },

  // Закрытие активной вкладки или панели
  "close_tab": {
    "keys": ["Ctrl+W"],
    "description": "Закрыть активный документ на холсте"
  },

  // Создание новой пустой вкладки
  "new_tab": {
    "keys": ["Ctrl+N", "Ctrl+Shift+N"],
    "description": "Создать новый документ"
  },


  // Диалог открытия существующего файла
  "open_file": {
    "keys": ["Ctrl+O", "Ctrl+Shift+O"],
    "description": "Открыть файл"
  },

  // Открытие папки проекта (хранилища заметок)
  "open_folder": {
    "keys": ["Ctrl+Alt+O", "Alt+Shift+O"],
    "description": "Открыть папку проекта (хранилище заметок)"
  },


  // Сохранение текущего файла на диск
  "save_file": {
    "keys": ["Ctrl+S"],
    "description": "Сохранить файл"
  },

  // Обертывание выделения в жирный шрифт (**текст**)
  "toggle_bold": {
    "keys": ["Ctrl+B"],
    "description": "Сделать выделенный текст жирным (**текст**)"
  },

  // Обертывание выделения в курсив (*текст*)
  "toggle_italic": {
    "keys": ["Ctrl+I"],
    "description": "Сделать выделенный текст курсивом (*текст*)"
  },

  // Открепление вкладки в независимое плавающее окно
  "detach_window": {
    "keys": ["Ctrl+D"],
    "description": "Открепить документ в отдельное окно"
  },

  // Глобальный интерактивный граф связей всех заметок
  "toggle_graph": {
    "keys": ["Ctrl+G"],
    "description": "Показать / скрыть глобальный граф связей всех заметок (Global Graph)"
  },

  // Локальный интерактивный граф связей текущей заметки
  "toggle_local_graph": {
    "keys": ["Alt+G"],
    "description": "Показать / скрыть локальный граф связей текущей заметки (Local Graph)"
  },

  // Схема метро сюжета (Metro Transit Map) — строго Alt+M
  "toggle_metro": {
    "keys": ["Alt+M", "Ctrl+M"],
    "description": "Показать / скрыть схему метро сюжета (Metro Transit Map)"
  },



  // Визуальное включение / отключение полосы прокрутки (Scrollbar)
  "toggle_scrollbar": {
    "keys": ["Alt+K"],
    "description": "Показать / скрыть полосу прокрутки (Scrollbar)"
  },

  // Визуальное включение / отключение полосы точек строк (Line Dots / Gutter)
  "toggle_line_dots": {
    "keys": ["Alt+L"],
    "description": "Показать / скрыть полосу точек и номеров строк (Line Dots / Gutter)"
  },

  // Переключение режима отображения блоков (Live Mode ⟷ Source Mode)
  "toggle_live_mode": {
    "keys": ["Alt+E"],
    "description": "Переключить отображение блоков (Live Mode)"
  },

  // Переключение в сухой текстовый режим (Source Mode ⟷ Live Mode)
  "toggle_source_mode": {
    "keys": ["Alt+S"],
    "description": "Переключить сухой текстовый режим (Source Mode)"
  },

  // Привязка активной вкладки к левой половине (Left 50%)
  "tile_left": {
    "keys": ["Alt+Left"],
    "description": "Прикрепить активную вкладку к левой половине экрана (Left 50%)"
  },

  // Привязка активной вкладки к правой половине (Right 50%)
  "tile_right": {
    "keys": ["Alt+Right"],
    "description": "Прикрепить активную вкладку к правой половине экрана (Right 50%)"
  },

  // Распахнуть активную вкладку на весь экран (Maximize / Full Viewport)
  "tile_maximize": {
    "keys": ["Alt+Up"],
    "description": "Распахнуть активную вкладку на весь экран (Maximize / Full Viewport)"
  },

  // Восстановить исходный плавающий размер вкладки (Restore)
  "tile_restore": {
    "keys": ["Alt+Down"],
    "description": "Восстановить исходный плавающий размер вкладки (Restore)"
  },

  // Автоматический тайлинг всех вкладок на холсте
  "tile_workspace": {
    "keys": ["Alt+Shift+M"],
    "description": "Разложить все открытые вкладки плиткой по видимой области экрана (Tiling Split)"
  }
}


