{
  // Глобальные и контекстные горячие клавиши редактора.
  // Поддерживаемые модификаторы: Ctrl, Alt, Shift, Meta (Win/Cmd).
  // Поддерживаемые клавиши: буквы A-Z, цифры 0-9, F1-F12, Backspace, Tab, Space, Return/Enter, Escape и спецсимволы.
  // В массив "keys" можно указывать несколько альтернативных комбинаций.

  // Полное скрытие/показ шапки (Header) и строки статуса (Footer)
  "toggle_header_footer": {
    "keys": ["F9", "Ctrl+Shift+H", "Alt+H"],
    "description": "Показать / скрыть заголовок и статус-бар (Header и Footer)"
  },

  // Скрытие/показ только нижней панели со статистикой
  "toggle_footer": {
    "keys": ["Ctrl+Shift+F", "Alt+F"],
    "description": "Показать / скрыть только нижний статус-бар (Footer)"
  },

  // Скрытие/показ только верхней панели с заголовком документа
  "toggle_header": {
    "keys": ["Ctrl+Shift+U", "Alt+U"],
    "description": "Показать / скрыть только верхний заголовок (Header)"
  },

  // Включение/выключение режима разделенного экрана (Split View)
  "toggle_split": {
    "keys": ["Ctrl+\\"],
    "description": "Разделить экран (Split View)"
  },

  // Быстрое переключение листа: фиксированная центрированная ширина <-> растянуть на все окно
  "toggle_centered_mode": {
    "keys": ["Alt+W", "Ctrl+Shift+W"],
    "description": "Переключить ширину листа (по центру / на всю ширину)"
  },

  // Закрытие активной вкладки или панели
  "close_tab": {
    "keys": ["Ctrl+W", "Ctrl+Q", "Ctrl+F4"],
    "description": "Закрыть текущую вкладку или сплит"
  },

  // Создание новой пустой вкладки
  "new_tab": {
    "keys": ["Ctrl+N"],
    "description": "Создать новый документ"
  },

  // Диалог открытия существующего файла
  "open_file": {
    "keys": ["Ctrl+O"],
    "description": "Открыть файл"
  },

  // Сохранение текущего файла на диск
  "save_file": {
    "keys": ["Ctrl+S"],
    "description": "Сохранить файл"
  },

  // Обертывание выделения в жирный шрифт Markdown (**текст**)
  "toggle_bold": {
    "keys": ["Ctrl+B"],
    "description": "Сделать выделенный текст жирным (**текст**)"
  },

  // Обертывание выделения в курсив Markdown (*текст*)
  "toggle_italic": {
    "keys": ["Ctrl+I"],
    "description": "Сделать выделенный текст курсивом (*текст*)"
  },

  // Открепление вкладки в независимое плавающее окно
  "detach_window": {
    "keys": ["Ctrl+D", "Alt+D"],
    "description": "Открепить документ в отдельное окно"
  },

  // Полноэкранный интерактивный граф связей заметок
  "toggle_graph": {
    "keys": ["Ctrl+G", "Ctrl+Shift+G"],
    "description": "Показать / скрыть интерактивный граф связей (Graph View)"
  }
}
