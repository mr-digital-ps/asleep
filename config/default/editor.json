{
  // Ширина листа с текстом документа в пикселях.
  // Рекомендуемый диапазон: 600 - 1400. Дефолт: 800
  "sheet_width": 800,

  // Базовый размер шрифта текста документа в пикселях.
  // Рекомендуемый диапазон: 12 - 24. Дефолт: 15
  "font_size": 15,

  // Межстрочный интервал (1.35 = 135% высоты строки для комфортного чтения).
  // Рекомендуемый диапазон: 1.15 - 1.8. Дефолт: 1.35
  "line_height": 1.35,

  // Показывать ли вспомогательные маркеры/точки для строк и списков
  "show_line_dots": true,

  // Внутренний отступ текста слева (внутри страницы)
  "padding_left": 0,

  // Внутренний отступ текста справа (внутри страницы)
  "padding_right": 0,

  // Внутренний отступ страницы сверху
  "padding_top": 6,

  // Внутренний отступ страницы снизу
  "padding_bottom": 0,

  // Режим пишущей машинки: текущая строка ввода всегда центрируется по вертикали
  "typewriter_mode": false,

  // Режим фокуса: акцентирует внимание на текущем предложении/абзаце
  "focus_mode": false,

  // Количество пробелов при нажатии клавиши Tab
  "tab_size": 4
}
