{
  // =========================================================================
  // Эталонная конфигурация диалекта asleep-pyqt (System Default)
  // Канонические 14 единиц синтаксиса
  // =========================================================================

  // Настройки вики-ссылок и локальных связей [[Имя Файла]]
  "wikilinks": {
    "pattern": "\\[\\[([^\\]#]+)(?:#[^\\]]+)?\\]\\]",
    "link_pattern": "\\[([^\\]]+)\\]\\(([^)]+\\.txt)\\)",
    "target_extensions": [".txt"],
    "case_sensitive": false
  },

  // Настройки тегов в тексте (#тег)
  "tags": {
    "pattern": "(?<!\\S)#([a-zA-Zа-яА-ЯёЁ0-9_\\-]+)(?!\\S)",
    "min_occurrences_for_graph": 2
  },

  // Настройки именованных блоков Имя { ... } и трансклюзий
  "blocks": {
    // Однострочный или многострочный именованный блок: Имя { ... }
    "named_block_pattern": "^[ \\t]*([a-zA-Zа-яА-ЯёЁ0-9_\\-\\s]+?)\\s*\\{([\\s\\S]*?)\\}",
    // Заголовок начала многострочного блока: Имя {
    "block_start_pattern": "^[ \\t]*([a-zA-Zа-яА-ЯёЁ0-9_\\-\\s]+?)\\s*\\{\\s*$",
    // Локальная трансклюзия: Имя()
    "local_transclusion_pattern": "(?<![a-zA-Zа-яА-ЯёЁ0-9_])([a-zA-Zа-яА-ЯёЁ0-9_\\-]+)\\(\\)",
    // Внешняя трансклюзия: ИмяФайла.ИмяБлока()
    "external_transclusion_pattern": "(?<![a-zA-Zа-яА-ЯёЁ0-9_])([a-zA-Zа-яА-ЯёЁ0-9_\\-\\s]+)\\.([a-zA-Zа-яА-ЯёЁ0-9_\\-]+)\\(\\)",
    // Fallback regex для обратной совместимости
    "heading_pattern": "^[ \\t]*([a-zA-Zа-яА-ЯёЁ0-9_\\-\\s]+?)\\s*\\{",
    "smart_enter_auto_fill": true,
    "safe_merge": true,
    "graph_transclusion_level": 1,
    "min_occurrences_for_graph": 2
  },

  // Настройки задач (чек-листов)
  "tasks": {
    "open_pattern": "^[ \\t]*[-*+]\\s+\\[ \\]",
    "done_pattern": "^[ \\t]*[-*+]\\s+\\[[xX]\\]",
    "default_marker": "- [ ] "
  },

  // Настройки списков
  "lists": {
    "bullet_markers": ["-", "+"],
    "ordered_auto_increment": true
  }
}
