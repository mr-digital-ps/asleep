{
  // Задержка автосохранения документа в миллисекундах после остановки ввода текста (1000 = 1 секунда)
  "auto_save_delay_ms": 1000,

  // Поддерживаемые расширения текстовых файлов
  "supported_extensions": [".md", ".markdown", ".txt"],

  // Игнорируемые служебные папки (скрываются из проводника)
  "ignored_directories": [".git", ".venv", "__pycache__", "node_modules", ".asleep"],

  // Язык интерфейса
  "language": "ru",

  // Целевая частота кадров (FPS):
  // "auto" — автоматически адаптируется под частоту развертки монитора (60, 120, 144, 240+ Гц)
  // "unlimited" (или 0) — снятие всех ограничений FPS (максимальная частота кадров)
  // Число (например 60, 120, 144, 240) — фиксированный целевой FPS
  "target_fps": "auto",

  // Вертикальная синхронизация (VSync):
  // true — кадры синхронизируются с экраном (максимальная плавность без разрывов)
  // false — VSync выключен (минимальный инпут-лаг, возможен тиринг)
  "vsync": true
}
