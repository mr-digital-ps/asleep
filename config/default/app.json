{
  // Задержка автосохранения документа в миллисекундах после остановки ввода текста (1000 = 1 секунда)
  "auto_save_delay_ms": 1000,

  // Поддерживаемые расширения текстовых файлов
  "supported_extensions": [".af", ".txt", ".md"],

  // Игнорируемые служебные папки (скрываются из проводника)
  "ignored_directories": [".git", ".venv", "__pycache__", "node_modules", ".asleep", "archive", "_archive"],

  // Язык интерфейса
  "language": "ru",

  // Целевая частота кадров (FPS):
  // "auto" — автоматически адаптируется под частоту развертки монитора (60, 120, 144, 240+ Гц)
  // "unlimited" (или 0) — снятие всех ограничений FPS (максимальная частота кадров)
  // Число (например 60, 120, 144, 240) — фиксированный целевой FPS
  "target_fps": "auto",

  // Вертикальная синхронизация (VSync):
  // true — кадры синхронизируются с экраном (максимальная плавность без разрывов)
  // false — VSync выключен (минимальный инпут-лаг, возможен тиринг)
  "vsync": true,

  // Геометрия окна по умолчанию
  "window_default_width": 900,
  "window_default_height": 650,
  "window_min_width": 600,
  "window_min_height": 400,
  "window_resize_margin": 10,
  "window_corner_margin": 20,
  "window_save_geometry_delay_ms": 600,

  // Перемещение окна приложения по экрану ОС:
  // window_drag_enabled — включить/отключить перетаскивание окна по экрану (Alt+ЛКМ и ПКМ)
  // window_drag_deadzone — мертвая зона мыши (в пикселях) для ПКМ перед началом перемещения
  "window_drag_enabled": true,
  "window_drag_deadzone": 3.0
}
