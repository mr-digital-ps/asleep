{
  // Дефолтная рабочая папка (используется при первом запуске или если last_folder недоступна)
  "default_folder": "~/Documents/Notes",

  // Последняя открытая рабочая папка (переопределяется в config/user/session.json)
  "last_folder": "",

  // Геометрия окна по умолчанию
  "win_width": 1000,
  "win_height": 700,
  "win_x": -1,
  "win_y": -1,

  // Параметры листа и панелей
  "sheet_width": 800,
  "sidebar_width": 240,
  "font_size": 15,

  // Состояние хедера
  "header_pinned": true,
  "header_visible": true,
  "header_height": 70,

  // Визуальное отображение служебных элементов редактора
  "show_scrollbar": true,
  "show_line_dots": true
}
