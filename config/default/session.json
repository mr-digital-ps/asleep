{
	// Дефолтная рабочая папка (поддерживаются относительные "europe-read", кроссплатформенные "C:/..." и Windows пути)
	"default_folder": "C:/.personal/.development/asleep-pyqt/europe-write",

	// Последняя открытая рабочая папка (переопределяется в config/user/session.json)
	"last_folder": "",

	// Последний открытый файл заметки (переопределяется в config/user/session.json)
	"last_file": "",

	// Режим редактора по умолчанию (true = Live Mode, false = Source Mode)
	"is_live_mode": true,

	// Геометрия окна по умолчанию
	"win_width": 1000,
	"win_height": 700,
	"win_x": -1,
	"win_y": -1,

	// Параметры листа и панелей
	"sheet_width": 800,
	"sidebar_width": 240,
	"font_size": 15,

	// Состояние хедера
	"header_pinned": true,
	"header_visible": true,

	// Визуальное отображение служебных элементов редактора
	"show_scrollbar": true,
	"show_line_dots": true
}
