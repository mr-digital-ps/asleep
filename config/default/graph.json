{
  "physics": {
    // Сила отталкивания между узлами (закон Кулона).
    // Чем выше значение, тем дальше узлы расталкиваются друг от друга.
    // Рекомендуемый диапазон: 500 - 10000. Дефолт: 3600
    "repulsion": 3600,

    // Максимальное расстояние (px), на котором действует сила отталкивания.
    // Узлы, находящиеся дальше, не влияют друг на друга, что экономит производительность.
    // Рекомендуемый диапазон: 200 - 1500. Дефолт: 800
    "repulsionDistanceMax": 800,

    // Базовая (равновесная) длина соединительных линий в пикселях.
    // К этому значению ребра стремятся вернуться в состоянии покоя.
    // Рекомендуемый диапазон: 30 - 200. Дефолт: 85
    "linkDistance": 85,

    // Жесткость связей (коэффициент упругости пружины по закону Гука).
    // Маленькое значение (0.01 - 0.02) дает эффект мягкой растяжимой резины.
    // Большое значение (0.08 - 0.2) делает связи жесткими как каркас.
    // Рекомендуемый диапазон: 0.005 - 0.15. Дефолт: 0.014
    "linkStrength": 0.014,

    // Коэффициент пластической деформации ребра при растяжении (0.0 - 0.1).
    // Когда вы оттягиваете узел дальше базовой длины, ребро постепенно запоминает новую длину.
    // 0.0 = абсолютно упругая связь (не запоминает растяжение). Дефолт: 0.035
    "plasticDeformation": 0.035,

    // Максимальный предел длины пластического растяжения связи в пикселях.
    // Ограничивает предельную длину ребра при перетаскивании.
    // Рекомендуемый диапазон: 150 - 600. Дефолт: 300
    "plasticMaxDistance": 300,

    // Скорость восстановления деформированного ребра обратно к базовой длине.
    // Чем выше, тем быстрее растянутый граф возвращается в исходную компактную форму.
    // Рекомендуемый диапазон: 0.0001 - 0.005. Дефолт: 0.0005
    "plasticRecoveryRate": 0.0005,

    // Центральная гравитация (сила притяжения всех узлов к центру экрана).
    // Удерживает несвязанные узлы и островки в поле зрения.
    // Рекомендуемый диапазон: 0.0001 - 0.002. Дефолт: 0.0005
    "gravity": 0.0005,

    // Коэффициент трения / затухания скорости (0.0 = мгновенная остановка, 1.0 = вечное движение).
    // Предотвращает бесконечные колебания и вибрации узлов.
    // Рекомендуемый диапазон: 0.70 - 0.90. Дефолт: 0.82
    "damping": 0.82,

    // Ограничение максимальной скорости перемещения узла за один кадр (px/frame).
    // Защищает физику от разлета узлов в бесконечность при резких движениях.
    // Рекомендуемый диапазон: 5.0 - 30.0. Дефолт: 15.0
    "maxVelocity": 15.0,

    // Радиус начального разброса узлов при первом появлении графа (доля от размера экрана).
    // Рекомендуемый диапазон: 0.1 - 0.8. Дефолт: 0.35
    "initialSpread": 0.35
  },
  "visual": {
    // Минимальный радиус узла в пикселях (для заметок с малым числом связей)
    "nodeRadiusMin": 3.5,

    // Максимальный радиус узла в пикселях (для популярных узлов-хабов)
    "nodeRadiusMax": 8.5,

    // Базовый радиус узла без связей
    "nodeRadiusBase": 3.2,

    // Прирост радиуса узла за каждую входящую/исходящую связь
    "nodeRadiusWeight": 1.3,

    // Фоновый цвет интерактивного холста графа
    "backgroundColor": "#181818",

    // Цвет узлов документов и файлов Markdown
    "nodeColorFile": "#585858",

    // Цвет узлов отдельных блоков (трансклюзий)
    "nodeColorBlock": "#424242",

    // Цвет узлов тегов (#тег)
    "nodeColorTag": "#4c4c4c",

    // Коэффициент подсветки узла при наведении курсора мыши (1.0 = без подсветки)
    "nodeHoverBrightness": 1.25,

    // Базовый цвет соединительных линий в покое
    "linkColor": "#363636",

    // Цвет соединительных линий при наведении или перетаскивании узла
    "linkHoverColor": "#666666",

    // Базовый цвет текстовых подписей узлов
    "labelColor": "#8a8a8a",

    // Цвет текстовой подписи при наведении мыши
    "labelHoverColor": "#ffffff",

    // Размер шрифта подписей узлов в пикселях
    "labelFontSize": 10,

    // Отображать ли узлы именованных блоков (горячая клавиша B)
    "showBlocks": true,

    // Отображать ли рёбра (линии) именованных блоков (горячая клавиша Shift+B)
    "showBlockEdges": true,

    // Отображать ли узлы тегов (горячая клавиша T)
    "showTags": true,

    // Отображать ли рёбра (линии) тегов (горячая клавиша Shift+T)
    "showTagEdges": true,

    // Отображать ли обычные файлы и связи-ссылки между файлами (горячая клавиша L)
    "showLinks": true,

    // Отображать ли рёбра (линии) обычных ссылок [[...]] (горячая клавиша Shift+L)
    "showLinkEdges": true
  }
}
