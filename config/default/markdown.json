{
  // =========================================================================
  // Эталонная конфигурация диалекта Markdown для asleep-pyqt (System Default)
  // =========================================================================

  // Настройки вики-ссылок и локальных связей
  "wikilinks": {
    // Регулярное выражение для поиска вики-ссылок [[Заметка#Секция|Алиас]]
    // Группа 1: имя заметки, группа 2 (опционально): псевдоним
    "pattern": "\\[\\[([^\\]|#]+)(?:#[^\\]|]+)?(?:\\|([^\\]]+))?\\]\\]",

    // Регулярное выражение для стандартных Markdown-ссылок на локальные файлы [текст](путь.md)
    "md_link_pattern": "\\[([^\\]]+)\\]\\(([^)]+\\.(?:md|markdown|txt))\\)",

    // Поддерживаемые расширения файлов для построения связей графа
    "target_extensions": [".md", ".markdown", ".txt"],

    // Учитывать ли регистр при сопоставлении имен заметок
    "case_sensitive": false
  },

  // Настройки тегов в тексте (#тег)
  "tags": {
    // Регулярное выражение для поиска тегов
    // Разрешены: латиница, кириллица, цифры, дефис и подчеркивание, отделенные пробелами
    "pattern": "(?<!\\S)#([a-zA-Zа-яА-ЯёЁ0-9_\\-]+)(?!\\S)",

    // Минимальное число заметок с данным тегом для материализации в интерактивном графе
    "min_occurrences_for_graph": 2
  },

  // Настройки блочного движка и трансклюзии (#..###### Заголовок)
  "blocks": {
    // Регулярное выражение для заголовков блоков
    // Группа 1: решетки (#{1,6}), группа 2: заголовок блока
    "heading_pattern": "^[ \\t]*(#{1,6})\\s+(.+)$",

    // Автоматически подтягивать контент существующего блока при нажатии Enter после заголовка
    "smart_enter_auto_fill": true,

    // Защита от затирания: пустой блок никогда не перезаписывает блок с существующими данными
    "safe_merge": true,

    // Уровень заголовка для материализации трансклюзионного узла в графе (1 = только H1 #)
    "graph_transclusion_level": 1,

    // Минимальное число файлов с одинаковым H1 для создания узла трансклюзии в графе
    "min_occurrences_for_graph": 2
  },

  // Настройки задач (чек-листов)
  "tasks": {
    // Регулярное выражение для открытой (незавершенной) задачи
    "open_pattern": "^[ \\t]*[-*+]\\s+\\[ \\]",

    // Регулярное выражение для выполненной задачи
    "done_pattern": "^[ \\t]*[-*+]\\s+\\[[xX]\\]",

    // Маркер вставки новой задачи по умолчанию
    "default_marker": "- [ ] "
  },

  // Настройки списков
  "lists": {
    // Допустимые маркеры неупорядоченных списков
    "bullet_markers": ["-", "*", "+"],

    // Автоматический инкремент номеров в упорядоченных списках (1. -> 2.) при Smart Enter
    "ordered_auto_increment": true
  },

  // Служебные и системные файлы (исключаются из графа заметок)
  "system_files": {
    // Имя файла визуальной структуры/дерева проекта
    "structure_file": "_Структура.md",

    // Имя файла автоматической проекции связей графа
    "graph_file": "_Граф связей.md",

    // Префикс файла локальных настроек каталога
    "folder_config_prefix": "_Настройка каталога ",

    // Префиксы файлов и папок, игнорируемых при индексации графа заметок
    "ignore_prefixes": ["_", "."]
  }
}
