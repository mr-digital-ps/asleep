{
	// 1. Поверхности и фоновые цвета (Surfaces)
	"bg_app": "#141414", // Фон подложки всего окна
	"bg_paper": "#181818", // Фон листа редактора (sheet)
	"bg_header": "#181818", // Фон шапки документа (sticky header)
	"bg_footer": "#181818", // Фон нижней строки состояния
	"bg_hover": "#202020", // Фон при наведении мыши (кнопки, вкладки, файлы)
	"bg_active": "#282828", // Фон активного/выбранного элемента списка
	"bg_dialog": "#1e1e1e", // Фон всплывающих диалоговых окон

	// 2. Цвета текста (Typography)
	"text_primary": "#d4d4d4", // Основной цвет текста заметок
	"text_secondary": "#737373", // Второстепенный текст (статистика, пути)
	"text_muted": "#525252", // Неактивный/приглушенный текст (плейсхолдеры)
	"text_selected": "#ffffff", // Цвет текста внутри выделения
	"text_hover": "#ffffff", // Текст при наведении курсора

	// 3. Редактор текста (Editor Canvas)
	"cursor_color": "#e0e0e0", // Цвет курсора ввода "|"
	"selection_color": "#282828", // Фон выделения текста
	"selection_radius": 5, // Радиус скругления углов выделения (выпуклых и вогнутых)
	"line_highlight": "#0effffff", // Подсветка текущей строки
	"gutter_text": "#505050", // Номера строк в левой полосе
	"gutter_active": "#999999", // Номер текущей строки
	"bracket_match": "#888888", // Подсветка парных скобок () [] {}

	// 4. Границы и разделители (Borders & Dividers)
	"border_color": "#262626", // Тонкие разделительные линии и рамка сплита
	"border_focus": "#555555", // Граница поля при фокусе
	"border_hover": "#333333", // Границы при наведении

	// 5. Пользовательский акцентный цвет и элементы управления (Accents)
	// Пользователь может задать любой оттенок (например: "#3b82f6" синий, "#10b981" изумрудный, "#f59e0b" янтарный, "#8b5cf6" фиолетовый или монохромный "#d4d4d4")
	"accent_color": "#d4d4d4", // Главный акцентный цвет (закрепленная шапка, направляющие снапа, активные кольца графа)
	"accent_hover": "#ffffff", // Акцент при наведении (чистый белый или яркий тон)
	"accent_active": "#888888", // Акцент при нажатии
	"scrollbar_thumb": "#484848", // Ползунок полосы прокрутки (ярче дорожки)
	"scrollbar_hover": "#646464", // Ползунок скроллбара при наведении
	"scrollbar_track": "#18ffffff", // Направляющая линия дорожки скроллбара
	"danger_color": "#ef4444", // Цвет закрытия/удаления
	"diff_added": "#22c55e", // Цвет добавленных строк в истории
	"diff_added_bg": "#122316", // Мягкий фон добавленных строк
	"diff_deleted": "#ef4444", // Цвет удаленных строк в истории
	"diff_deleted_bg": "#241416", // Мягкий фон удаленных строк

	// 6. Геометрия и типографика (Geometry & Tokens)
	"bar_size": 36, // Размер боковых служебных полос (gutter/scrollbar)
	"header_height": 70, // Высота шапки документа
	"header_title_font_size": 18, // Размер шрифта заголовка документа
	"default_sheet_width": 800, // Дефолтная ширина листа
	"min_sheet_width": 380, // Минимальная ширина листа
	"max_sheet_width": 2000, // Максимальная ширина листа
	"default_font_size": 15, // Базовый размер шрифта редактора
	"font_family": "Consolas", // Единый глобальный шрифт приложения и редактора
	"sheet_padding": 16, // Внутренний вертикальный отступ контента листа
	"default_tab_size": 4, // Количество пробелов для символа табуляции
	"default_line_height_percent": 135.0, // Высота строки редактора в процентах

	// 7. Тайминги и анимации (Animation Timings)
	"anim_duration_fast": 100, // Быстрые микро-анимации (hover, размер ползунка)
	"anim_duration_normal": 150, // Стандартные переходы (opacity, границы, сплит)
  "canvas_panel_width": 800,
  "canvas_panel_height": 720,
  "canvas_panel_gap": 40,
  "canvas_drag_height": 24,
  "canvas_resize_margin": 6,
  "canvas_min_height": 300,
  "canvas_snap_distance": 18,
  "canvas_grid_step": 32,
  "canvas_min_zoom": 0.3,
  "canvas_max_zoom": 2.5,
  "canvas_zoom_step": 1.1
}
