{
  // Базовая ширина боковой панели (сайдбара) в пикселях
  "sidebar_width": 260,

  // Минимальная ширина сайдбара при растягивании мышью
  "sidebar_min_width": 180,

  // Максимальная ширина сайдбара
  "sidebar_max_width": 480,

  // Основной фоновый цвет рабочей области редактора (HEX)
  "bg_app": "#141414",

  // Фоновый цвет боковой панели (сайдбара)
  "bg_sidebar": "#171717",

  // Цвет тонких разделительных линий и границ
  "border_color": "#262626",

  // Главный акцентный цвет интерфейса (курсор, ссылки, кнопки)
  "accent_color": "#4da6ff",

  // Основной цвет текста документа и интерфейса
  "text_primary": "#d4d4d4",

  // Второстепенный цвет текста (статистика, счетчики, пути файлов)
  "text_secondary": "#737373",

  // Показывать ли верхнюю шапку документа по умолчанию
  "header_visible": true,

  // Показывать ли нижнюю строку состояния по умолчанию
  "footer_visible": true
}
